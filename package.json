{
  "name": "@ai-by-design/primitiv",
  "version": "1.6.0",
  "description": "The reconciliation layer for agentic design systems. Sits above Figma, your codebase, and Storybook — resolves conflicts, exposes a single source of truth via MCP.",
  "main": "dist/index.js",
  "bin": {
    "primitiv": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "biome lint src",
    "fmt": "biome format --write src",
    "check": "biome check src",
    "test": "bun test"
  },
  "keywords": [
    "design-system",
    "mcp",
    "agentic",
    "primitives",
    "tokens",
    "figma",
    "storybook",
    "cursor",
    "claude-code"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-by-design/primitiv.git"
  },
  "bugs": {
    "url": "https://github.com/AI-by-design/primitiv/issues"
  },
  "homepage": "https://github.com/AI-by-design/primitiv#readme",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.0.0",
    "glob": "^13.0.6",
    "ora": "^9.3.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/bun": "^1.2.0",
    "@types/node": "^25.5.0",
    "ts-node": "^10.0.0",
    "typescript": "^6.0.2"
  }
}
